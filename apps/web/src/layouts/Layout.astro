---
import '../styles/global.css';
import ThemeSwitcher from '../components/ui/ThemeSwitcher.tsx';
import FontSwitcher from '../components/ui/FontSwitcher.tsx';
import Icon from '@/components/ui/Icon.astro';
import { VERSION, SLOGAN } from '@/lib/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CS, visualized — cs.thefarshad.com',
  description = 'Learn computer science visually: data structures, algorithms, systems, and more, with interactive visualizers and runnable problems.',
} = Astro.props;

// Set the saved theme before first paint to avoid a flash.
const themeInit = `(()=>{try{var d=document.documentElement;var t=localStorage.getItem('cs-theme');if(t)d.dataset.theme=t;var f=localStorage.getItem('cs-font');if(f)d.dataset.font=f;}catch(e){}})();`;
---

<!doctype html>
<html lang="en" data-theme="retro-gold">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Roboto:wght@400;500;700&family=Ubuntu:wght@400;500;700&family=VT323&display=swap"
      rel="stylesheet"
    />
    <script is:inline set:html={themeInit} />
  </head>
  <body class="min-h-screen font-body antialiased">
    <header class="sticky top-0 z-40 border-b border-edge bg-bg/80 backdrop-blur">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3">
        <a href="/" class="flex items-center gap-2 font-display text-2xl">
          <Icon name="code" size={22} class="text-accent" />
          <span class="text-fg">cs.thefarshad</span>
        </a>
        <nav class="flex items-center gap-3 text-sm text-muted">
          <a href="/problems" class="hidden hover:text-fg sm:inline">Problems</a>
          <a href="/#tracks" class="hidden hover:text-fg sm:inline">Tracks</a>
          <ThemeSwitcher client:load />
          <FontSwitcher client:load />
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-20 border-t border-edge">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 py-8 text-sm text-muted">
        <span class="font-mono">v{VERSION}</span>
        <span>{SLOGAN}</span>
      </div>
    </footer>
  </body>
</html>
