---
import Layout from '@/layouts/Layout.astro';
import { PROBLEMS } from '@/lib/problems';
---

<Layout title="Problems — cs.thefarshad.com" description="Practice problems you can solve and run in the browser.">
  <section class="mx-auto max-w-3xl px-4 py-12">
    <nav class="mb-6 flex items-center gap-2 text-sm text-muted">
      <a href="/" class="hover:text-fg">Home</a>
      <span>/</span>
      <span class="text-fg">Problems</span>
    </nav>
    <header class="mb-8">
      <h1 class="font-display text-4xl text-accent sm:text-5xl">Problems</h1>
      <p class="mt-2 text-lg text-muted">Solve them and run your code right here — Python and JavaScript execute live in your browser.</p>
    </header>

    <ul class="divide-y divide-edge overflow-hidden rounded-xl border border-edge">
      {
        PROBLEMS.map((p) => (
          <li>
            <a href={`/problems/${p.slug}`} class="flex items-center gap-4 bg-surface px-5 py-4 transition hover:bg-accent/5">
              <span class="min-w-0">
                <span class="block font-display text-lg text-fg">{p.title}</span>
                <span class="block text-sm text-muted">{p.topic}</span>
              </span>
              <span class="ml-auto shrink-0 rounded border border-edge px-2 py-0.5 text-xs text-muted capitalize">{p.difficulty}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
