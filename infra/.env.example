# cs.thefarshad.com — backend environment (EXAMPLE / template)
#
# Copy this file to `.env` in the SAME directory and fill in real values:
#   cp infra/.env.example infra/.env
#
# `.env` is git-ignored and must NEVER be committed. The values below are
# placeholders only. Generate strong, random secrets on the host.

# --- Postgres -----------------------------------------------------------------
# Credentials for the `postgres` service. The database is internal-only (not
# exposed to the host); these are still used to authenticate the api service.
POSTGRES_USER=cs_app
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=cs

# --- API: database connection -------------------------------------------------
# Connection string the api uses to reach Postgres. The host is the docker
# service name `postgres` (NOT localhost) and the port is the in-container 5432.
# Keep the user/password/db in sync with the POSTGRES_* values above.
DATABASE_URL=postgresql://cs_app:change-me-strong-db-password@postgres:5432/cs

# --- API: auth ----------------------------------------------------------------
# Secret used to sign/verify session/JWT tokens. Use a long random string, e.g.
#   openssl rand -hex 32
JWT_SECRET=change-me-long-random-string

# --- API: CORS / frontend origin ----------------------------------------------
# The browser origin allowed to call the API (the static site on GitHub Pages).
APP_ORIGIN=https://cs.thefarshad.com

# --- SMTP (optional) ----------------------------------------------------------
# Only needed for magic-link / transactional email. Leave blank to disable.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=postmaster@example.com
# SMTP_PASSWORD=change-me-smtp-password
# SMTP_FROM="cs.thefarshad.com <no-reply@cs.thefarshad.com>"
