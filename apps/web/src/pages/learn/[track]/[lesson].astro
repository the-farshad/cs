---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/Icon.astro';
import LessonComplete from '@/components/ui/LessonComplete.tsx';
import { trackBySlug } from '@/lib/tracks';

export async function getStaticPaths() {
  const lessons = (await getCollection('lessons')).filter((e) => !e.data.draft);
  return lessons.map((entry) => ({
    params: { track: entry.data.track, lesson: entry.id.split('/').pop()! },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'lessons'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const track = trackBySlug(entry.data.track);

const siblings = (await getCollection('lessons'))
  .filter((e) => !e.data.draft && e.data.track === entry.data.track)
  .sort((a, b) => a.data.order - b.data.order);
const idx = siblings.findIndex((e) => e.id === entry.id);
const prev = idx > 0 ? siblings[idx - 1] : null;
const next = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : null;
const hrefFor = (e: CollectionEntry<'lessons'>) => `/learn/${e.data.track}/${e.id.split('/').pop()}`;
---

<Layout title={`${entry.data.title} — cs.thefarshad.com`} description={entry.data.summary}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <nav class="mb-6 flex items-center gap-2 text-sm text-muted">
      <a href="/" class="hover:text-fg">Home</a>
      <span>/</span>
      <a href={`/learn/${entry.data.track}`} class="hover:text-fg">{track?.title ?? entry.data.track}</a>
      <span>/</span>
      <span class="text-fg">{entry.data.title}</span>
    </nav>

    <header class="mb-8">
      <span class="inline-block rounded border border-edge px-2 py-0.5 text-xs text-muted capitalize">{entry.data.difficulty}</span>
      <h1 class="mt-3 font-display text-4xl text-accent sm:text-5xl">{entry.data.title}</h1>
      <p class="mt-2 text-lg text-muted">{entry.data.summary}</p>
    </header>

    <div class="prose-cs">
      <Content />
    </div>

    <div class="mt-12 border-t border-edge pt-6">
      <LessonComplete id={entry.id} client:load />
    </div>

    <nav class="mt-8 flex justify-between gap-4 text-sm">
      {
        prev ? (
          <a href={hrefFor(prev)} class="inline-flex items-center gap-1.5 text-muted hover:text-fg">
            <Icon name="arrow-left" size={16} /> {prev.data.title}
          </a>
        ) : (
          <span></span>
        )
      }
      {
        next ? (
          <a href={hrefFor(next)} class="inline-flex items-center gap-1.5 text-muted hover:text-fg">
            {next.data.title} <Icon name="arrow-right" size={16} />
          </a>
        ) : (
          <span></span>
        )
      }
    </nav>
  </article>
</Layout>
