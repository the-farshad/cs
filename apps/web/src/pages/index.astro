---
import Layout from '../layouts/Layout.astro';
import SortVisualizer from '../components/viz/SortVisualizer.tsx';

const tracks = [
  { title: 'Data Structures', desc: 'Arrays, lists, trees, heaps, graphs — every structure, animated.', icon: '🌳' },
  { title: 'Algorithms', desc: 'Sorting, searching, recursion, DP, and graph algorithms.', icon: '⚡' },
  { title: 'CS Systems', desc: 'Big-O, operating systems, networking, database internals.', icon: '🧠' },
  { title: 'System Design', desc: 'Scaling, caching, consistency, consensus, case studies.', icon: '🏛️' },
  { title: 'SQL', desc: 'Queries, joins, indexes — with an in-browser playground.', icon: '🗄️' },
  { title: 'Git', desc: 'The commit DAG and workflows, explored interactively.', icon: '🌿' },
  { title: 'Bash', desc: 'The shell, pipes, and scripting in a safe sandbox.', icon: '❯' },
  { title: 'Robotics', desc: 'Kinematics, PID control, and path planning.', icon: '🤖' },
  { title: 'ML / RL / Math', desc: 'Probability, optimization, and reinforcement learning.', icon: '∑' },
];
---

<Layout>
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-10 text-center">
    <h1 class="font-display text-5xl leading-tight sm:text-7xl">
      <span class="text-accent">Computer science,</span>
      <span class="text-fg">visualized.</span>
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-muted">
      Learn data structures, algorithms, systems, and more — every concept
      animated, every topic backed by problems you can run right in the browser.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4">
    <div class="mb-3 flex items-baseline justify-between">
      <h2 class="font-display text-2xl text-fg">Try it: sorting</h2>
      <span class="text-sm text-muted">a taste of the visualizers</span>
    </div>
    <SortVisualizer client:visible />
  </section>

  <section id="tracks" class="mx-auto max-w-6xl px-4 pt-16">
    <h2 class="font-display text-3xl text-fg">Tracks</h2>
    <p class="mt-1 text-muted">The full map. Lessons, visualizers, and problems land here track by track.</p>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        tracks.map((t) => (
          <article class="group rounded-xl border border-edge bg-surface p-5 transition hover:border-accent">
            <div class="text-2xl">{t.icon}</div>
            <h3 class="mt-2 font-display text-xl text-fg transition group-hover:text-accent">{t.title}</h3>
            <p class="mt-1 text-sm text-muted">{t.desc}</p>
            <span class="mt-3 inline-block text-xs tracking-wide text-muted uppercase">Coming soon</span>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
