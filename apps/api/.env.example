# cs.thefarshad.com API — example environment.
# Copy to `.env` and fill in real values for local development.
# NEVER commit a real .env (see .gitignore).

# --- Required ---

# Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cs

# Secret used to sign JWTs. Use a long, random value in production.
JWT_SECRET=change-me-to-a-long-random-string

# --- Optional (have sane defaults) ---

# Public origin of the frontend. Used to build magic links and for CORS.
# Defaults to https://cs.thefarshad.com. http://localhost:4321 is always allowed.
APP_ORIGIN=https://cs.thefarshad.com

# Port the API listens on. Defaults to 8080.
PORT=8080

# --- Optional: SMTP for magic-link email ---
# If these are NOT set, /auth/request returns a `devLink` in its JSON response
# instead of sending an email (handy for local development).
# When SMTP_HOST is set, magic links are emailed and devLink is omitted.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="cs.thefarshad.com <no-reply@thefarshad.com>"
